# "mock" (default) uses the in-browser mock API with sample data.
# "http" calls a real backend implementing src/shared/api/types.ts.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Server-only real analysis configuration. Never prefix these with NEXT_PUBLIC_.
# If either API key is missing, the backend safely uses the mock analysis provider.
STT_PROVIDER=openai-compatible
STT_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_API_KEY=

# Optional OpenAI-compatible overrides (defaults target api.openai.com).
# STT_BASE_URL=https://api.openai.com/v1/audio/transcriptions
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# STT_MODEL=gpt-4o-mini-transcribe
# LLM_MODEL=gpt-4o-mini
# ANALYSIS_TIMEOUT_MS=30000
