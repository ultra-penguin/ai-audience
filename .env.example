# "mock" (default) uses the in-browser mock API with sample data.
# "http" calls a real backend implementing src/shared/api/types.ts.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Server-only real analysis configuration. Never prefix these with NEXT_PUBLIC_.
# If GROQ_API_KEY is missing, the backend safely uses the mock analysis provider.
STT_PROVIDER=groq
STT_API_KEY=
LLM_PROVIDER=groq
LLM_API_KEY=
GROQ_API_KEY=

# Groq OpenAI-compatible endpoints and models used by default.
# One GROQ_API_KEY is enough for both calls.
# STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# STT_MODEL=whisper-large-v3-turbo
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# ANALYSIS_TIMEOUT_MS=30000
